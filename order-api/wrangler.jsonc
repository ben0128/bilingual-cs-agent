{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-order-api",
  "main": "src/main.py",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["python_workers"],
  // Demo page (public/index.html) is served straight from Static Assets.
  // Only these paths reach the Python Worker, so the page never waits on a cold start.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/tools/*", "/health", "/docs", "/openapi.json"]
  }
}
