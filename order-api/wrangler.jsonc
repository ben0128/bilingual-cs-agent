{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-order-api",
  "main": "src/main.py",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["python_workers"],
  // Demo page (public/index.html) is served by the same Worker.
  // run_worker_first: API routes are checked before static files.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
